+def _upgrade_legacy_openfold_state_dict(model_state):
+    legacy_prefixes = (
+        "trunk.structure_module.ipa.linear_q_points.",
+        "trunk.structure_module.ipa.linear_kv_points.",
+    )
+
+    for prefix in legacy_prefixes:
+        for suffix in ("weight", "bias"):
+            legacy_key = prefix + suffix
+            openfold_2_key = prefix + "linear." + suffix
+            if legacy_key in model_state and openfold_2_key not in model_state:
+                model_state[openfold_2_key] = model_state[legacy_key]
+
+
@@ -22,0 +37 @@
